{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["es2022"],
		"module": "preserve",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/**/*"]
}
