NODE_ENV = development
DATABASE_CONNECTION_URL = "postgres://postgres:postgres@localhost:5432/zar_imen"
serverPort = 8010
swaggerApiDocPath = /api-docs
swaggerApiPath = /api

# ---- auth
# at least 32 characters
jwtSecret = "replace-with-a-long-random-string-0000000000"
jwtExpire = "10d"
# the admins, comma-separated; each logs in to zarimen.ir/panel with an SMS code
adminPhoneNumbers = "09120000000,09130000000"

# ---- sms.ir
smsIrSecret = "your-sms-ir-api-key"
# sms.ir verify template id with one CODE parameter
smsIrOtpTemplate = "123456"
# sms.ir sender line number for plain-text bulk messages (new-ticket notice to the admins)
smsIrLineNumber = "30002128011371"
# sms.ir verify templates for shop requests (zarimen.ir/signup); set the real ids later
# canceled request, one INFO parameter
smsIrShopRejectedTemplate = "000000"
# registered shop's welcome, one SUBDOMAIN parameter
smsIrShopWelcomeTemplate = "000000"
# false = print the OTP in the backend console instead of sending it
sendSms = false

# ---- api.ir (Shahkar: phone <-> national code, CardMatch: card <-> national code)
ApiIRToken = "your-api-ir-token"
# false = skip the identity checks in local development
identityCheck = false

# ---- ArvanCloud image bucket (shop logos go to the zar-imen/ folder)
imageBucketBaseUrl = "https://your-bucket.s3.ir-central1.arvanstorage.ir"
arvanRegion = "default"
arvanAccessKey = ""
arvanSecretKey = ""

# ---- shop sites: {subdomain} is replaced by the shop's subdomain
shopSiteUrl = "http://{subdomain}.localhost:3010"

# ---- Zarinpal (shop wallet top-ups; amounts are sent in Tomans)
zarinPalMerchantId = "00000000-0000-0000-0000-000000000000"
# public base url of this backend; Zarinpal returns payers to callbacks under it
backendUrl = "http://127.0.0.1:8010"
# empty for production; https://sandbox.zarinpal.com for testing without real money
zarinpalBaseUrl = "https://sandbox.zarinpal.com"
