/// A plan the admin sells to shops (zarimen.ir/panel/settings). Disabled, never deleted:
/// purchases point at it.
model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  /// e.g. «اشتراک یک‌ماهه»
  title        String
  /// Whole Tomans
  price        Decimal  @db.Decimal(20, 0)
  durationDays Int
  /// Only active plans are offered to owners.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases SubscriptionPurchase[]
}

/// A shop buying a plan through SePal, or the admin moving its end date (`planId` null,
/// price 0, written as SUCCESS). Title, price and duration are copied from the plan at purchase
/// time, so later plan changes do not rewrite history.
model SubscriptionPurchase {
  id           String                     @id @default(uuid()) @db.Uuid
  shopId       String                     @db.Uuid
  shop         Shop                       @relation(fields: [shopId], references: [id])
  /// Null for the admin's changes.
  planId       String?                    @db.Uuid
  plan         SubscriptionPlan?          @relation(fields: [planId], references: [id])
  planTitle    String
  price        Decimal                    @db.Decimal(20, 0)
  durationDays Int
  status       SubscriptionPurchaseStatus @default(PENDING)
  /// VAT paid on top of `price` (whole Tomans); the gateway charged price + vatAmount.
  vatAmount    Decimal                    @default(0) @db.Decimal(20, 0)

  /// The period this purchase added, set when it is paid.
  startsAt DateTime?
  endsAt   DateTime?

  /// The gateway's id for the payment (SePal paymentNumber; Zarinpal authority on old rows).
  /// gatewayCode: Zarinpal only.
  authority   String? @unique
  refId       String?
  cardPan     String?
  gatewayCode Int?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, createdAt])
}

enum SubscriptionPurchaseStatus {
  PENDING
  SUCCESS
  FAILED
  /// Still PENDING 20 minutes after it started (owner never came back from the gateway).
  CANCELED
}
