{
	"$schema": "https://swc.rs/schema.json",
	"sourceMaps": true,
	"jsc": {
		"baseUrl": ".",
		"paths": {
			"~": ["src"],
			"~/*": ["src/*"]
		},
		"parser": {
			"syntax": "typescript",
			"decorators": true
		},
		"transform": {
			"legacyDecorator": true,
			"decoratorMetadata": true
		},
		"keepClassNames": true
	}
}
